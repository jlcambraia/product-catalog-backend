PORT=3001
MONGO_URL=mongodb://127.0.0.1:27017/product_catalog
# Optional for public read-only catalog operation.
# When absent, all write endpoints reject requests with HTTP 401.
# To enable real write operations, configure a high-entropy secret
# and send it only from a trusted server as X-Internal-API-Key.
# INTERNAL_API_KEY=replace-with-a-long-random-secret
